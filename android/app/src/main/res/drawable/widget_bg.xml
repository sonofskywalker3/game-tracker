<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card background: brand near-black tile (matches the launcher icon)
     with rounded corners. Drawable (not GlanceModifier.cornerRadius) so it
     renders identically on every supported Android version. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#181A22" />
    <corners android:radius="16dp" />
</shape>
