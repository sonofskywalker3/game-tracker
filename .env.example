# Auth gate turns ON only when BACKLOGQUEST_PASSWORD_HASH is set.
# Generate a hash:
#   uv run python -c "from werkzeug.security import generate_password_hash as h; print(h('YOUR_PASSWORD'))"
BACKLOGQUEST_PASSWORD_HASH=
# Flask session cookie signing key (any long random string).
BACKLOGQUEST_SESSION_SECRET=
# Bearer token the Android app stores after login (any long random string).
BACKLOGQUEST_API_TOKEN=
# Bearer token the home scrape-push uses (any long random string).
BACKLOGQUEST_IMPORT_TOKEN=
# Set to 1 on the cloud deployment to disable the in-app scraper.
BACKLOGQUEST_CLOUD=
# Public base URL of this deployment (e.g. https://backlogquest.xyz), used for
# the desktop scraper sidecar's server_url when behind a TLS-terminating proxy.
BACKLOGQUEST_PUBLIC_URL=
