# Auth gate turns ON only when BOTH Google OAuth vars below are set. Create an
# OAuth 2.0 Client (type: Web application) in Google Cloud Console; add the
# redirect URI https://<your-domain>/auth/callback. Set BOTH or neither — a
# half-configured pair makes the app refuse to start (fail closed).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated allowlist of Google account emails permitted to sign in.
BACKLOGQUEST_ALLOWED_EMAILS=
# Owner's Google email; this account claims user #1 (the pre-existing library).
BACKLOGQUEST_OWNER_EMAIL=
# Flask session cookie signing key (any long random string).
BACKLOGQUEST_SESSION_SECRET=
# Bearer token the Android app stores after login (any long random string).
BACKLOGQUEST_API_TOKEN=
# Bearer token the home scrape-push uses (any long random string).
BACKLOGQUEST_IMPORT_TOKEN=
# Set to 1 on the cloud deployment to disable the in-app scraper.
BACKLOGQUEST_CLOUD=
# Public base URL of this deployment (e.g. https://backlogquest.xyz), used for
# the desktop scraper sidecar's server_url when behind a TLS-terminating proxy.
BACKLOGQUEST_PUBLIC_URL=
# Directory on the server holding published desktop scraper artifacts
# (portable zip / installer exe / version.txt); see scraper_dist.py.
BACKLOGQUEST_SCRAPER_DIR=
